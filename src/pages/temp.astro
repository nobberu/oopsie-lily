                    "❤️",
                ],
                successTitle: "YAY! KAN DIBILANG JUGA APA! 🎉",
                successDesc:
                    "Screenshot layar ini terus kirim balik ke aku ya! 😉✨",
            },
            // Scratch Card Text
            scratch: {
                secretMessage:
                    "Sebenarnya aku udah suka sama kamu dari lama! 🫣",
            },
        };

        // ==========================================
        // 🚀 APPLICATION LOGIC
        // ==========================================
        let dodgeCount = 0;

        window.onload = function () {
            // Apply Initial Configurations
            document.getElementById("dodge-question-text").innerText =
                CONFIG.dodge.question;
            document.getElementById("dodge-subtext-text").innerText =
                CONFIG.dodge.subtext;
            document.getElementById("yes-btn-text").innerText =
                CONFIG.dodge.yesBtnText;
            document.getElementById("no-btn-text").innerText =
                CONFIG.dodge.noBtnText;
            document.getElementById("modal-title").innerText =
                CONFIG.dodge.successTitle;
            document.getElementById("modal-desc").innerText =
                CONFIG.dodge.successDesc;

            document.getElementById("input-to").value = CONFIG.secret.defaultTo;
            document.getElementById("input-msg").value =
                CONFIG.secret.defaultMsg;
            document.getElementById("scratch-secret-text").innerText =
                `"${CONFIG.scratch.secretMessage}"`;

            // Check URL Params for Shared Notes
            const params = new URLSearchParams(window.location.search);
            if (params.get("msg")) {
                document.getElementById("input-msg").value = decodeURIComponent(
                    params.get("msg"),
                );
                if (params.get("to"))
                    document.getElementById("input-to").value =
                        decodeURIComponent(params.get("to"));
                switchTab("secret");
            }

            updateCard();
            initScratch();
        };

        // Tab Switcher
        function switchTab(tab) {
            document
                .querySelectorAll(".tab-content")
                .forEach((el) => el.classList.add("hidden"));
            document.querySelectorAll(".tab-btn").forEach((btn) => {
                btn.classList.remove("bg-rose-500", "text-white");
                btn.classList.add("text-slate-400");
            });

            document.getElementById(`tab-${tab}`).classList.remove("hidden");
            const activeBtn = document.getElementById(`nav-${tab}`);
            activeBtn.classList.add("bg-rose-500", "text-white");
            activeBtn.classList.remove("text-slate-400");

            if (tab === "scratch") setTimeout(initScratch, 50);
        }

        // Dodge Logic
        function dodgeNoButton() {
            dodgeCount++;
            const noBtn = document.getElementById("no-btn");
            const yesBtn = document.getElementById("yes-btn");
            const emoji = document.getElementById("dodge-emoji");

            const x = (Math.random() - 0.5) * 200;
            const y = (Math.random() - 0.5) * 100;
            noBtn.style.transform = `translate(${x}px, ${y}px)`;

            const scale = Math.min(1 + dodgeCount * 0.1, 1.5);
            yesBtn.style.transform = `scale(${scale})`;

            const emojis = CONFIG.dodge.emojis;
            emoji.innerText = emojis[Math.min(dodgeCount, emojis.length - 1)];
        }

        function handleYesClick() {
            document.getElementById("success-modal").classList.remove("hidden");
        }

        function closeModal() {
            dodgeCount = 0;
            document.getElementById("no-btn").style.transform =
                "translate(0px, 0px)";
            document.getElementById("yes-btn").style.transform = "scale(1)";
            document.getElementById("dodge-emoji").innerText =
                CONFIG.dodge.emojis[0];
            document.getElementById("success-modal").classList.add("hidden");
        }

        // Custom Note Update
        function updateCard() {
            const to = document.getElementById("input-to").value || "Kamu";
            const msg = document.getElementById("input-msg").value || "...";
            document.getElementById("preview-to").innerText = to;
            document.getElementById("preview-msg").innerText = `"${msg}"`;
        }

        function copyShareLink() {
            const msg = encodeURIComponent(
                document.getElementById("input-msg").value,
            );
            const to = encodeURIComponent(
                document.getElementById("input-to").value,
            );
            const url = `${window.location.origin}${window.location.pathname}?msg=${msg}&to=${to}`;

            navigator.clipboard.writeText(url).then(() => {
                alert(
                    "Link pesan berhasil disalin ke clipboard! Tinggal kirim ke dia 🚀",
                );
            });
        }

        // Scratch Canvas logic
        function initScratch() {
            const canvas = document.getElementById("scratch-canvas");
            if (!canvas) return;
            const ctx = canvas.getContext("2d");

            canvas.width = canvas.offsetWidth || 320;
            canvas.height = canvas.offsetHeight || 240;

            ctx.fillStyle = "#475569";
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            ctx.fillStyle = "#cbd5e1";
            ctx.font = "bold 14px sans-serif";
            ctx.textAlign = "center";
            ctx.fillText(
                "✨ GOSOK DI SINI ✨",
                canvas.width / 2,
                canvas.height / 2,
            );

            let isScratching = false;

            function scratch(e) {
                if (!isScratching) return;
                const rect = canvas.getBoundingClientRect();
                const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                const x = clientX - rect.left;
                const y = clientY - rect.top;

                ctx.globalCompositeOperation = "destination-out";
                ctx.beginPath();
                ctx.arc(x, y, 20, 0, Math.PI * 2);
                ctx.fill();
            }

            canvas.onmousedown = (e) => {
                isScratching = true;
                scratch(e);
            };
            canvas.onmousemove = scratch;
            window.onmouseup = () => {
                isScratching = false;
            };

            canvas.ontouchstart = (e) => {
                isScratching = true;
                scratch(e);
            };
            canvas.ontouchmove = scratch;
            window.ontouchend = () => {
                isScratching = false;
            };
        }
    </script>
</Layout>
